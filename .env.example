# Supabase (copy to .env.local and fill with your project values)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — required for Kiosk RPE submit and admin user actions
SUPABASE_SERVICE_ROLE_KEY=

# Server-only — Kiosk Lock PIN, set a real value only in local/deployment env
KIOSK_PIN=

# Server-only — Power BI / Microsoft Entra (never use NEXT_PUBLIC_ for these)
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_WORKSPACE_ID=
POWERBI_DATASET_ID=
